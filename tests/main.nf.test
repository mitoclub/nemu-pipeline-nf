// # single protein fasta

// # multiple protein fasta

// # nucl multifasta with protein input type flag

// # proteins to nucl type

// # one nucl multifasta

// # several nucl multifasta files

// # species name for some species and same without species name option

// # 

nextflow_pipeline {

    name "Test NeMu Pipeline - Parameter Validation"
    script "main.nf"

    test("Should handle help parameter correctly") {

        tag "help"
        tag "parameter_validation"

        when {
            params {
                help = true
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().size() == 0
        }
    }

    test("Should fail with invalid input type") {

        tag "invalid_input_type"
        tag "parameter_validation"

        when {
            params {
                input = "${projectDir}/test_data/nemu_input/CO1.fasta"
                inputType = "invalid_type"
                help = false
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail gracefully with missing required parameters for protein input") {

        tag "protein_missing_required"
        tag "parameter_validation"

        when {
            params {
                input = "${projectDir}/test_data/test_proteins.fasta"
                inputType = "protein"
                help = false
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail when nucleotide input path is missing") {

        tag "nucleotide_missing_input"
        tag "parameter_validation"

        when {
            params {
                input = "${projectDir}/test_data/does_not_exist/*.fasta"
                inputType = "nucleotide_coding"
                help = false
            }
        }

        then {
            assert workflow.failed
        }
    }
}
