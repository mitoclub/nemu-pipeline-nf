Bootstrap: docker
From: mambaorg/micromamba:2.4.0
    
%files
    environment.yml /app/
    main.nf /app/
    nextflow.config /app/

%post
    # export PATH="/opt/conda/bin:$PATH"
    micromamba install -y -n base -f /app/environment.yml
    micromamba clean --all --yes

%environment
    # export PATH="/opt/conda/bin:$PATH"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    eval "$(micromamba shell hook --shell bash)" # TODO check
    micromamba activate base
    exec nextflow run "$@" # TODO fix env activation 

%labels
    Maintainer kpotoh, mitofungen.com
    Version v1.0.2
