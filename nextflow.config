//  -qs, -queue-size TODO check
//executor {
//    name = 'local'
//    cpus = 32             // Total threads Nextflow can utilize
//    queueSize = 32            // Max concurrent tasks handled by the executor
//}


params {
    // Inputs/Outputs
    input = ""
    inputType = "cds"                          // protein, cds, noncds TODO make understandable naming...
    gencode = 1                                // Genetic code table
    saveIntermeds = false                      // Save intermediate files

    // Protein Input
    db = ""                                    // BLAST nucleotide database path (required absolute path, e.g. /db/core_nt)
    taxdump = ""
    maxTargetSeqs = 2000
    speciesName = ""                         // Override species name (Optional)

    // Nucleotide Input
    outgroupId = "OUTGRP"                      // Outgroup sequence ID
    aligned = false                             // Nucleotide input is pre-aligned

    // Pipeline Logic
    threads = 1                                // threads per each input

    // MSA & Tree
    minSeqs = 4                                 // Min sequences to proceed phylogeny and ASR
    minMuts = 5                                 // Min reconstructed mutations to derive a spectrum
    msaMode = "auto"                           // auto, macse (accurate codon alignment), mafft_macse, mafft (not recommended for CDS)
    model = "GTR+FO+G4+I"                       // IQ-TREE Model
    modelAsr = "GTR+FO+G4+I"                   // ASR Model (auto = same as tree)
    runTreeShrink = true                        // Run TreeShrink to prune long branches
    treefile = ""                              // Provide pre-computed tree path to skip tree building

    // Mutation Extraction
    consCatCutoff = 0                          // 0 = no cutoff
    probaArg = true                             // Use probabilities
    uncertaintyCoef = true                      // Use phylogeny uncertainty coefficient

    // Spectra Calculation
    plot = true                                 // Generate plots of spectra and tree
    internal = false
    terminal = false
    branchSpectra = false
    // spectraType = "syn"                        // syn, syn4f, nonsyn, all
}
