outputDir = 'results'

// https://www.nextflow.io/docs/edge/conda.html#best-practices TODO
// https://www.nextflow.io/docs/edge/config.html#config-profiles
// profiles {
//   mamba {
//     process.conda = 'environment.yml or path/to/environment/dir'
//     conda.enabled = true
//     conda.useMamba = true
//   }

//   conda {
//     process.conda = 'environment.yml or path/to/environment/dir'
//     conda.enabled = true
//   }

//   docker {
//     process.container = 'kpotoh/nemu-pipeline:latest' // TODO
//     docker.enabled = true
//   }

//  -qs, -queue-size TODO check
executor {
   name = 'local'
   cpus = 8             // Total threads Nextflow can utilize
//    queueSize = 32       // Max concurrent tasks handled by the executor
}

params {
    // Inputs/Outputs
    input = ""
    inputType = "cds"                          // protein, cds, noncds
    gencode = 1                                // Genetic code table
    saveIntermeds = false                      // Keep MSA scratch files in the task directory

    // Protein Input
    db = ""                                    // BLAST nucleotide database path (required absolute path, e.g. /db/core_nt)
    taxdump = ""
    maxHits = 2000                             // Max tblastn hits per query
    minIdentSpecies = 80                       // Percent identity for species BLAST hits
    minCovSpecies = 0.5                        // Query coverage for species BLAST hits
    minIdentOutgroup = 70                      // Percent identity for the outgroup BLAST hit
    minCovOutgroup = 0.5                       // Query coverage for the outgroup BLAST hit
    speciesName = ""                         // Override species name (Optional)

    // Nucleotide Input
    outgroupId = "OUTGRP"                      // Outgroup sequence ID
    aligned = false                             // Nucleotide input is pre-aligned

    // Pipeline Logic
    threads = 1                                // threads per each input

    // MSA & Tree
    minSeqs = 4                                 // Min sequences to proceed phylogeny and ASR
    minMuts = 5                                 // Min reconstructed mutations to derive a spectrum
    msaMode = "auto"                           // auto, macse (accurate codon alignment), mafft_macse, mafft (not recommended for CDS)
    maxGapSeq = 0.5                            // Drop sequences above this gap fraction
    maxGapSite = 0.5                           // Drop alignment columns above this gap fraction
    model = "GTR+FO+G4+I"                       // IQ-TREE Model
    modelAsr = "GTR+FO+G4+I"                   // ASR Model (auto = same as tree)
    treeShrink = true                          // Prune long branches with TreeShrink
    treeShrinkQuantile = 0.1                   // TreeShrink branch-length quantile
    outgroupTopN = 5                           // Keep OUTGRP among this many longest branches
    treefile = ""                              // Provide pre-computed tree path to skip tree building

    // Mutation Extraction
    rateCutoff = 0                             // 0 = no cutoff
    proba = true                               // Weight mutations by ancestral-state probability
    minProba = 0.3                             // Minimum ancestral-state probability
    phyloCoef = true                           // Downweight mutations on deep branches

    // Spectra Calculation
    plot = true                                 // Generate plots of spectra and tree
    internalBranches = false                   // Also derive spectra for internal branches
    terminalBranches = false                   // Also derive spectra for terminal branches
    perBranch = false                          // Also derive one spectrum per branch
    minMuts192 = 16                            // Minimum observations per 192-class context
    // spectraType = "syn"                        // syn, syn4f, nonsyn, all
}
