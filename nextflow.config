process {
    executor = "local"
    cpus = 8 // threads for all inputs
}

// Docker configuration
// docker.enabled = true
// process.container = 'nemu-pipeline:latest'

// Alternative: Singularity
// singularity.enabled = true
// process.container = 'nemu-pipeline.sif'

// Alternative: Mamba/Conda environment
// conda.enabled = true
// process.conda = 'environment.yml'


params {
    // Inputs/Outputs
    input_type = "protein"                     // protein, nucleotide_coding, nucleotide_noncoding
    input = "data/proteins.fa"
    outdir = "results"
    gencode = 2                                 // Genetic code table

    // Protein Input
    db = "/home/kpotoh/.nuc_db/dolphin"
    taxdump = "/home/kpotoh/.taxonkit"
    species_name = false                         // Override species name
    max_target_seqs = 2000

    // Nucleotide Input
    outgroup_id = "OUTGRP"                      // Outgroup sequence ID
    aligned = false                             // Nucleotide input is pre-aligned

    // Pipeline Logic
    threads = 4                                // threads per each input

    // MSA & Tree
    min_seqs = 4                                 // Min sequences to proceed
    msa_mode = "auto"                           // auto, macse (accurate codon alignment), mafft_macse, mafft
    model = "GTR+FO+G4+I"                       // IQ-TREE Model
    model_asr = "GTR+FO+G4+I"                   // ASR Model (auto = same as tree)
    run_treeshrink = true                        // Run TreeShrink to prune long branches

    // Mutation Extraction
    cons_cat_cutoff = 0                          // 0 = no cutoff
    proba_arg = true                             // Use probabilities
    uncertainty_coef = true                      // Use phylogeny uncertainty coefficient

    // Spectra Calculation
    plot = true                                 // Generate plots
    internal = false
    terminal = false
    branch_spectra = false
}
